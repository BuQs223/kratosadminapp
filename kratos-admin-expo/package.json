    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-calendars": "1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.1",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-modules-jsi.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "preandroid:release": "npm run verify:eas-update",
    "android:release": "expo run:android --device --variant release",
    "preios:release": "npm run verify:eas-update",
    "ios:release": "expo run:ios --device --configuration Release",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:parity": "node ../audits/2026-09-13-report-parity/verify-parity.cjs",
    "doctor": "expo-doctor",
    "eas:configure": "npx eas-cli@latest update:configure",
    "verify:eas-update": "node ./scripts/verify-eas-update-config.mjs",
    "verify:eas-production-env": "node ./scripts/verify-eas-production-env.mjs",
    "env:import-flutter": "node ./scripts/import-flutter-env.mjs",
    "icons:import-flutter": "node ./scripts/import-flutter-icons.mjs",
    "preupdate:production": "npm run verify:eas-update && npm run verify:eas-production-env",
    "update:production": "npx eas-cli@latest update --channel production --environment production"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
